{
  "manifest_version": 3,
  "name": "Max Combo Hide",
  "version": "0.1.0",
  "description": "Hides AliExpress product cards labelled \"Max Combo\".",
  "content_scripts": [
    {
      "matches": [
        "*://*.aliexpress.com/*",
        "*://*.aliexpress.us/*",
        "*://*.aliexpress.ru/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
