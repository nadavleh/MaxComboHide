{
  "manifest_version": 3,
  "name": "Max Combo Hide",
  "version": "0.2.0",
  "description": "Hides AliExpress product cards labelled \"Max Combo\".",
  "permissions": ["storage"],
  "background": { "service_worker": "background.js" },
  "action": { "default_popup": "popup.html", "default_title": "Max Combo Hide" },
  "content_scripts": [
    {
      "matches": [
        "*://*.aliexpress.com/*",
        "*://*.aliexpress.us/*",
        "*://*.aliexpress.ru/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
